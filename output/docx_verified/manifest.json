  "equations": [
    {
      "number": 1,
      "labels": [],
      "latex": "\\mathrm{SOH}=\\frac{C_{\\mathrm{current}}}{C_{\\mathrm{rated}}}\\times100\\%,"
    },
    {
      "number": 2,
      "labels": [],
      "latex": "CCCT(V_1,V_2)=t(V_2)-t(V_1),"
    },
    {
      "number": 3,
      "labels": [],
      "latex": "IC=\\frac{dQ}{dV}\\approx\\frac{Q_{k+N}-Q_k}{V_{k+N}-V_k},"
    },
    {
      "number": 4,
      "labels": [],
      "latex": "DTV=\\frac{dT}{dV}\\approx\\frac{T_{k+N}-T_k}{V_{k+N}-V_k},"
    },
    {
      "number": 5,
      "labels": [],
      "latex": "DTC=\\frac{dT}{dQ}\\approx\\frac{T_{k+N}-T_k}{Q_{k+N}-Q_k},"
    },
    {
      "number": 6,
      "labels": [],
      "latex": "Q_{\\mathrm{dch}}(V_h,V_l)=\\frac{1}{3600}\\int_{\\{t:\\,V_l\\leq V_{\\mathrm{dch}}(t)\\leq V_h\\}}\\left|I_{\\mathrm{dch}}(t)\\right|\\,dt,"
    },
    {
      "number": 7,
      "labels": [],
      "latex": "\\eta=\\frac{E_{\\mathrm{dch}}}{E_{\\mathrm{ch}}}=\\frac{\\int_0^{t_{\\mathrm{dch}}}V_{\\mathrm{dch}}(t)\\left|I_{\\mathrm{dch}}(t)\\right|\\,dt}{\\int_0^{t_{\\mathrm{ch}}}V_{\\mathrm{ch}}(t)\\left|I_{\\mathrm{ch}}(t)\\right|\\,dt},"
    },
    {
      "number": 8,
      "labels": [],
      "latex": "\\gamma_{i,j}=\n\\frac{\\displaystyle\\sum_{k=1}^{n_j}(f_{i,j,k}-\\bar{f}_{i,j})(y_{j,k}-\\bar{y}_j)}\n     {\\displaystyle\\sqrt{\\sum_{k=1}^{n_j}(f_{i,j,k}-\\bar{f}_{i,j})^2\\sum_{k=1}^{n_j}(y_{j,k}-\\bar{y}_j)^2}},"
    },
    {
      "number": 9,
      "labels": [],
      "latex": "\\rho_{i,j}=\n\\frac{\\displaystyle\\sum_{k=1}^{n_j}\\bigl(R(f_{i,j,k})-\\bar{R}(f_{i,j})\\bigr)\\bigl(R(y_{j,k})-\\bar{R}(y_j)\\bigr)}\n{\\displaystyle\\sqrt{\\sum_{k=1}^{n_j}\\bigl(R(f_{i,j,k})-\\bar{R}(f_{i,j})\\bigr)^2\\sum_{k=1}^{n_j}\\bigl(R(y_{j,k})-\\bar{R}(y_j)\\bigr)^2}},"
    },
    {
      "number": 10,
      "labels": [],
      "latex": "S_i=\\min(mPCC_i,mSCC_i)."
    },
    {
      "number": 11,
      "labels": [
        "eq:block_slfa"
      ],
      "latex": "\\mathbf X_l'\n=\n\\operatorname{SLFA}(\\mathbf X_l)."
    },
    {
      "number": 12,
      "labels": [
        "eq:block_dsconv_l"
      ],
      "latex": "\\mathbf X_l''\n=\n\\mathbf X_l'\n+\nW_l\n\\operatorname{DSConv\\text{-}L}\n\\left(\n\\operatorname{LN}(\\mathbf X_l')\n\\right)."
    },
    {
      "number": 13,
      "labels": [
        "eq:block_ffn"
      ],
      "latex": "\\mathbf Y_l\n=\n\\mathbf X_l''+\n\\operatorname{FFN}\n\\left(\n\\operatorname{LN}_0(\\mathbf X_l'')\n\\right)."
    },
    {
      "number": 14,
      "labels": [
        "eq:conv_cost"
      ],
      "latex": "C_{\\mathrm{Conv}}\n=\nk\\times k\\times C_{\\mathrm{in}}\\times C_{\\mathrm{out}}\\times D_F\\times D_F."
    },
    {
      "number": 15,
      "labels": [
        "eq:dsconv_cost"
      ],
      "latex": "C_{\\mathrm{DSConv}}\n=\nk\\times k\\times C_{\\mathrm{in}}\\times D_F\\times D_F\n+\nC_{\\mathrm{in}}\\times C_{\\mathrm{out}}\\times D_F\\times D_F."
    },
    {
      "number": 16,
      "labels": [
        "eq:dsconv_cost_ratio"
      ],
      "latex": "\\begin{aligned}\n\\frac{C_{\\mathrm{DSConv}}}{C_{\\mathrm{Conv}}}\n&=\n\\frac{\nk\\times k\\times C_{\\mathrm{in}}\\times D_F\\times D_F\n+\nC_{\\mathrm{in}}\\times C_{\\mathrm{out}}\\times D_F\\times D_F\n}{\nk\\times k\\times C_{\\mathrm{in}}\\times C_{\\mathrm{out}}\\times D_F\\times D_F\n} \\\\\n&=\n\\frac{1}{C_{\\mathrm{out}}}\n+\n\\frac{1}{k^2}.\n\\end{aligned}"
    },
    {
      "number": 17,
      "labels": [],
      "latex": "\\mathbf Y_1\n=\n\\operatorname{PW}_{\\uparrow}\n\\left(\n\\mathcal T(\\mathbf X)\n\\right)\n\\in\\mathbb R^{B\\times 2d\\times N}."
    },
    {
      "number": 18,
      "labels": [],
      "latex": "\\mathbf Y_2\n=\n\\operatorname{DW}_{5}(\\mathbf Y_1)\n\\in\\mathbb R^{B\\times 2d\\times N}."
    },
    {
      "number": 19,
      "labels": [],
      "latex": "\\mathbf Y_3\n=\n\\operatorname{ReLU}(\\mathbf Y_2)."
    },
    {
      "number": 20,
      "labels": [],
      "latex": "\\mathbf Y_4\n=\n\\operatorname{PW}_{\\downarrow}(\\mathbf Y_3)\n\\in\\mathbb R^{B\\times d\\times N}."
    },
    {
      "number": 21,
      "labels": [
        "eq:dsconv_s"
      ],
      "latex": "\\mathbf X_S\n=\n\\operatorname{DSConv\\text{-}S}(\\mathbf X)\n=\n\\mathbf X+\\mathcal T^{-1}(\\mathbf Y_4)."
    },
    {
      "number": 22,
      "labels": [
        "eq:dsconv_s_expanded_cost"
      ],
      "latex": "C_{\\mathrm{in}}\\times2C_{\\mathrm{out}}\\times D_F\\times D_F\n+1\\times5\\times2C_{\\mathrm{out}}\\times D_F\\times D_F\n+2C_{\\mathrm{out}}\\times C_{\\mathrm{out}}\\times D_F\\times D_F."
    },
    {
      "number": 23,
      "labels": [
        "eq:dsconv_l_expanded_cost"
      ],
      "latex": "C_{\\mathrm{in}}\\times3C_{\\mathrm{out}}\\times D_F\\times D_F\n+1\\times31\\times3C_{\\mathrm{out}}\\times D_F\\times D_F\n+3C_{\\mathrm{out}}\\times C_{\\mathrm{out}}\\times D_F\\times D_F."
    },
    {
      "number": 24,
      "labels": [
        "eq:qkv_projection"
      ],
      "latex": "\\mathbf Q_i=\\mathbf X\\mathbf W_i^Q,\\qquad\n\\mathbf K_i=\\mathbf X\\mathbf W_i^K,\\qquad\n\\mathbf V_i=\\mathbf X\\mathbf W_i^V."
    },
    {
      "number": 25,
      "labels": [
        "eq:general_attention"
      ],
      "latex": "\\mathbf O_{i,p}\n=\n\\frac{\n\\displaystyle\\sum_{j=1}^{N}\n\\operatorname{Sim}\\left(\\mathbf Q_{i,p},\\mathbf K_{i,j}\\right)\\mathbf V_{i,j}\n}{\n\\displaystyle\\sum_{j=1}^{N}\n\\operatorname{Sim}\\left(\\mathbf Q_{i,p},\\mathbf K_{i,j}\\right)\n},\n\\qquad p=1,2,\\ldots,N."
    },
    {
      "number": 26,
      "labels": [
        "eq:softmax_attention"
      ],
      "latex": "\\mathbf O_i\n=\n\\operatorname{Softmax}\n\\left(\n\\frac{\\mathbf Q_i\\mathbf K_i^{\\mathrm T}}{\\sqrt{d_h}}\n\\right)\n\\mathbf V_i."
    },
    {
      "number": 27,
      "labels": [
        "eq:linear_attention"
      ],
      "latex": "\\mathbf O_i\n=\n\\frac{\n\\phi(\\mathbf Q_i)\n\\left[\n\\phi(\\mathbf K_i)^{\\mathrm T}\\mathbf V_i\n\\right]\n}{\n\\phi(\\mathbf Q_i)\n\\left[\n\\phi(\\mathbf K_i)^{\\mathrm T}\\mathbf 1\n\\right]\n}."
    },
    {
      "number": 28,
      "labels": [
        "eq:raa_qkv_scaling"
      ],
      "latex": "\\mathbf Q_i=\\operatorname{Split}_i(\\mathbf X\\odot\\mathbf s_q),\\quad\n\\mathbf K_i=\\operatorname{Split}_i(\\mathbf X\\odot\\mathbf s_k),\\quad\n\\mathbf V_i=\\operatorname{Split}_i(\\mathbf X\\odot\\mathbf s_v)."
    },
    {
      "number": 29,
      "labels": [
        "eq:relu2_normalization"
      ],
      "latex": "\\left[\\mathcal R_2(\\mathbf Z)\\right]_{r,c}\n=\n\\begin{cases}\n\\dfrac{\\operatorname{ReLU}(\\mathbf Z_{r,c})^2}\n{\\sum_{j=1}^{M}\\operatorname{ReLU}(\\mathbf Z_{r,j})^2},\n&\n\\sum_{j=1}^{M}\\operatorname{ReLU}(\\mathbf Z_{r,j})^2>0,\\\\[10pt]\n\\dfrac{1}{M},\n&\n\\sum_{j=1}^{M}\\operatorname{ReLU}(\\mathbf Z_{r,j})^2=0.\n\\end{cases}"
    },
    {
      "number": 30,
      "labels": [
        "eq:agent_aggregation"
      ],
      "latex": "\\boldsymbol{\\Phi}_{k,i}\n=\n\\mathcal R_2\n\\left(\n\\frac{\\mathbf A_i\\mathbf K_i^{\\mathrm T}}{\\sqrt{d_h}}\n\\right),\n\\qquad\n\\mathbf V_{A,i}\n=\n\\boldsymbol{\\Phi}_{k,i}\\mathbf V_i."
    },
    {
      "number": 31,
      "labels": [
        "eq:agent_broadcast"
      ],
      "latex": "\\boldsymbol{\\Phi}_{q,i}\n=\n\\mathcal R_2\n\\left(\n\\frac{\\mathbf Q_i\\mathbf A_i^{\\mathrm T}}{\\sqrt{d_h}}\n\\right),\n\\qquad\n\\mathbf O_i\n=\n\\boldsymbol{\\Phi}_{q,i}\\mathbf V_{A,i}."
    },
    {
      "number": 32,
      "labels": [
        "eq:raa_output"
      ],
      "latex": "\\operatorname{RAA}(\\mathbf X)\n=\n\\mathbf X+\n\\operatorname{Concat}(\\mathbf O_1,\\ldots,\\mathbf O_h)\\odot\\mathbf s_o."
    },
    {
      "number": 33,
      "labels": [
        "eq:slfa_fusion"
      ],
      "latex": "\\mathbf X_F\n=\n\\operatorname{LN}(\\mathbf X_S)\n+\nW_a\n\\operatorname{Dropout}\n\\left(\n\\operatorname{RAA}(\\mathbf X_S)\n\\right)."
    },
    {
      "number": 34,
      "labels": [
        "eq:metric_mae"
      ],
      "latex": "\\mathrm{MAE}=\\frac{1}{n}\\sum_{i=1}^{n}\\left|y_i-\\hat{y}_i\\right|"
    },
    {
      "number": 35,
      "labels": [
        "eq:metric_mape"
      ],
      "latex": "\\mathrm{MAPE}=\\frac{1}{n}\\sum_{i=1}^{n}\\left|\\frac{y_i-\\hat{y}_i}{y_i}\\right|"
    },
    {
